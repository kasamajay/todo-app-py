# Copy to .env if you want to override defaults; docker-compose.yml already
# sets sane values for running everything through Docker Compose.

# api service
ADDR=:8080
DATA_DIR=/app/data

# web service - Docker service-name DNS, not localhost, since Vite runs
# inside the web container. Only change this if you run `npm run dev`
# directly on the host against a locally-running api process (in which case
# use http://localhost:8080 instead).
VITE_API_PROXY_TARGET=http://api:8080

# Google OAuth ("Sign in with Google" on the regular login screen only).
# Leave both blank to disable the feature - the api logs a warning at boot
# and the /api/auth/google/* routes respond 503.
#
# 1. https://console.cloud.google.com/apis/credentials > Create Credentials
#    > OAuth client ID > Application type: Web application.
# 2. Authorized redirect URI: http://localhost:5173/api/auth/google/callback
# 3. Paste the generated values below, then copy this file to .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: if you've reserved a free static ngrok domain (see README's
# "Public access via ngrok" section) and want Google sign-in to work
# through it too, uncomment and fill these in, then also add the matching
# Authorized redirect URI in Google Cloud Console:
# NGROK_DOMAIN=your-name.ngrok-free.app
# GOOGLE_REDIRECT_URI=https://your-name.ngrok-free.app/api/auth/google/callback
# FRONTEND_BASE_URL=https://your-name.ngrok-free.app

# Production mode (docker-compose.prod.yml, nginx on http://localhost:8081).
# Uses its own PROD_* names so the dev values above don't apply there. The
# defaults below are used when these are unset; for Google sign-in in prod,
# also add http://localhost:8081/api/auth/google/callback as an Authorized
# redirect URI in Google Cloud Console (GOOGLE_CLIENT_ID/SECRET are shared).
# PROD_GOOGLE_REDIRECT_URI=http://localhost:8081/api/auth/google/callback
# PROD_FRONTEND_BASE_URL=http://localhost:8081
