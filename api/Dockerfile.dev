FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dev image includes the test dependencies too, so
# `docker compose run --rm api pytest` works without a separate image.
COPY requirements.txt requirements-dev.txt ./
RUN pip install -r requirements-dev.txt

# Source is bind-mounted over this at runtime (see docker-compose.yml); the
# COPY here just keeps the image buildable/runnable standalone.
COPY . .

EXPOSE 8080

# --reload is the counterpart of air in the Go project. Docker Desktop's
# Windows bind mount doesn't propagate inotify events into the container,
# so docker-compose.yml sets WATCHFILES_FORCE_POLLING=true (decisions/0008).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload", "--reload-dir", "app", "--no-access-log"]
